<Window x:Class="Pebble.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Pebble" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" Width="460"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display">
  <Grid Margin="20,4,20,24">
    <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- arrow pointing up at the island -->
    <Path Data="M 0,14 L 14,0 L 28,14 Z" Fill="#1C1C1E" HorizontalAlignment="Center" Margin="0,0,0,-1"/>
    <Border Grid.Row="1" CornerRadius="20" Background="#1C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="24,22,24,18">
      <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.5"/></Border.Effect>
      <StackPanel x:Name="Card">
        <Border Width="52" Height="52" CornerRadius="16" Background="#26FFFFFF" HorizontalAlignment="Left">
          <TextBlock x:Name="StepIcon" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,14,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="StepBody" FontSize="13.5" Foreground="#C7C7CC" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
        <Grid Margin="0,20,0,0">
          <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SkipBtn" Content="Skip" Cursor="Hand" Focusable="False" Foreground="#8E8E93" FontSize="13" Margin="0,0,14,0">
              <Button.Template>
                <ControlTemplate TargetType="Button"><ContentPresenter VerticalAlignment="Center"/></ControlTemplate>
              </Button.Template>
            </Button>
            <Button x:Name="NextBtn" Cursor="Hand" Focusable="False" FontSize="13" FontWeight="SemiBold" Foreground="White">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="bg" Background="#0A84FF" CornerRadius="12" Padding="18,7"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.85"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
