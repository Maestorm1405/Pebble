<Window x:Class="Pebble.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pebble Color Picker" WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Canvas x:Name="Root">
    <Border x:Name="Loupe" Width="140" CornerRadius="18" Background="#1C1C1E" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="9" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5"/></Border.Effect>
      <StackPanel>
        <Border CornerRadius="12" Width="120" Height="120" ClipToBounds="True" Background="Black">
          <Grid>
            <Image x:Name="Zoom" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <Rectangle Width="10" Height="10" Stroke="White" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Rectangle Width="12" Height="12" Stroke="#80000000" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
          <Border x:Name="Swatch" Width="18" Height="18" CornerRadius="5" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>
          <TextBlock x:Name="Hex" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
        </StackPanel>
        <TextBlock Text="Click to copy · Esc to cancel" FontSize="10.5" Foreground="#8E8E93" Margin="2,5,0,0"/>
      </StackPanel>
    </Border>
  </Canvas>
</Window>
