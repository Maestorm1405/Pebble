<Window x:Class="Pebble.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pebble Search" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <!-- The window covers the bottom of the screen (transparent, clicks pass through empty areas).
       The pill and results are positioned on the canvas so they can grow out of the taskbar search box. -->
  <Canvas x:Name="Root">

    <!-- results, above the pill -->
    <Border x:Name="ResultsPanel" Width="660" CornerRadius="24" Background="#1C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1"
            Opacity="0" Visibility="Collapsed" ClipToBounds="True">
      <Border.RenderTransform><TranslateTransform x:Name="ResultsShift"/></Border.RenderTransform>
      <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.5"/></Border.Effect>
      <StackPanel x:Name="Results" Margin="8" VerticalAlignment="Top"/>
    </Border>

    <!-- the search pill -->
    <Border x:Name="PillShadow" CornerRadius="30" Background="#1C1C1E" Opacity="0"
            Width="{Binding ActualWidth, ElementName=Pill}" Height="{Binding ActualHeight, ElementName=Pill}">
      <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.55"/></Border.Effect>
    </Border>
    <Border x:Name="Pill" CornerRadius="30" Background="#1C1C1E" BorderBrush="#40FFFFFF" BorderThickness="1" ClipToBounds="True">
      <Grid x:Name="PillContent" Margin="22,0,14,0" Opacity="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#8E8E93" VerticalAlignment="Center"/>
        <Grid Grid.Column="1" Margin="14,0,10,0">
          <TextBox x:Name="Query" FontSize="19" Background="Transparent" Foreground="White" CaretBrush="White"
                   BorderThickness="0" VerticalContentAlignment="Center" SelectionBrush="#0A84FF"/>
          <TextBlock x:Name="Placeholder" Margin="2,0,0,0" Text="Search apps, settings, files, or do math"
                     FontSize="19" Foreground="#636366" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <Border Grid.Column="2" CornerRadius="8" Background="#26FFFFFF" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="esc" FontSize="11" Foreground="#8E8E93"/>
        </Border>
      </Grid>
    </Border>
  </Canvas>
</Window>
