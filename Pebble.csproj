<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Pebble</AssemblyName>
    <RootNamespace>Pebble</RootNamespace>
    <ApplicationIcon>Assets\Pebble.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Pebble</Product>
    <Description>A Dynamic Island for Windows</Description>
    <Version>1.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Pebble.ico" />
  </ItemGroup>

</Project>
